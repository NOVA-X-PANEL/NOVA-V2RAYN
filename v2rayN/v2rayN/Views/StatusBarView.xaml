<reactiveui:ReactiveUserControl
    x:Class="v2rayN.Views.StatusBarView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:reactiveui="http://reactiveui.net"
    xmlns:resx="clr-namespace:ServiceLib.Resx;assembly=ServiceLib"
    xmlns:tb="clr-namespace:H.NotifyIcon;assembly=H.NotifyIcon.Wpf"
    xmlns:vms="clr-namespace:ServiceLib.ViewModels;assembly=ServiceLib"
    d:DesignHeight="450"
    d:DesignWidth="800"
    x:TypeArguments="vms:StatusBarViewModel"
    Style="{StaticResource ViewGlobal}"
    mc:Ignorable="d">
    <Grid>
        <Border
            Background="#060912"
            BorderBrush="#162235"
            BorderThickness="0,1,0,0"
            Padding="12,6">
            <DockPanel LastChildFill="True">
                <StackPanel
                    Margin="{StaticResource MarginLeftRight8}"
                    VerticalAlignment="Center"
                    DockPanel.Dock="Right"
                    Orientation="Horizontal">
                    <Border
                        Background="#0D1527"
                        BorderBrush="#1E293B"
                        BorderThickness="1"
                        CornerRadius="6"
                        Padding="8,3"
                        Margin="0,0,6,0">
                        <StackPanel Orientation="Horizontal">
                            <materialDesign:PackIcon
                                Kind="Download"
                                Width="14"
                                Height="14"
                                Foreground="#00F0FF"
                                VerticalAlignment="Center"
                                Margin="0,0,4,0" />
                            <TextBlock
                                x:Name="txtSpeedProxyDisplay"
                                Foreground="#00F0FF"
                                FontWeight="Bold"
                                FontSize="11"
                                FontFamily="Consolas, Fira Code, monospace"
                                VerticalAlignment="Center" />
                        </StackPanel>
                    </Border>
                    <Border
                        Background="#0D1527"
                        BorderBrush="#1E293B"
                        BorderThickness="1"
                        CornerRadius="6"
                        Padding="8,3">
                        <StackPanel Orientation="Horizontal">
                            <materialDesign:PackIcon
                                Kind="Upload"
                                Width="14"
                                Height="14"
                                Foreground="#A78BFA"
                                VerticalAlignment="Center"
                                Margin="0,0,4,0" />
                            <TextBlock
                                x:Name="txtSpeedDirectDisplay"
                                Foreground="#A78BFA"
                                FontWeight="Bold"
                                FontSize="11"
                                FontFamily="Consolas, Fira Code, monospace"
                                VerticalAlignment="Center" />
                        </StackPanel>
                    </Border>
                </StackPanel>

                <StackPanel
                    Width="Auto"
                    Margin="{StaticResource MarginLeftRight8}"
                    VerticalAlignment="Center"
                    DockPanel.Dock="Left"
                    Orientation="Horizontal">
                    <Border
                        Background="#0A0E17"
                        BorderBrush="#162235"
                        BorderThickness="1"
                        CornerRadius="6"
                        Padding="8,3"
                        Margin="0,0,6,0">
                        <TextBlock
                            x:Name="txtInboundDisplay"
                            Foreground="#94A3B8"
                            FontSize="11"
                            FontFamily="Consolas, Fira Code, monospace" />
                    </Border>
                    <Border
                        Background="#0A0E17"
                        BorderBrush="#162235"
                        BorderThickness="1"
                        CornerRadius="6"
                        Padding="8,3">
                        <TextBlock
                            x:Name="txtInboundLanDisplay"
                            Foreground="#64748B"
                            FontSize="11"
                            FontFamily="Consolas, Fira Code, monospace" />
                    </Border>
                </StackPanel>

                <Border
                    x:Name="spEnableTun"
                    Background="#0D1A2D"
                    BorderBrush="#00F0FF"
                    BorderThickness="1"
                    CornerRadius="6"
                    Padding="8,3"
                    Margin="{StaticResource MarginLeftRight8}"
                    VerticalAlignment="Center"
                    DockPanel.Dock="Left">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <materialDesign:PackIcon
                            Kind="ShieldLockOutline"
                            Width="16"
                            Height="16"
                            Foreground="#00F0FF"
                            VerticalAlignment="Center"
                            Margin="0,0,6,0" />
                        <TextBlock
                            VerticalAlignment="Center"
                            Foreground="#E2E8F0"
                            FontWeight="SemiBold"
                            FontSize="11"
                            Text="{x:Static resx:ResUI.TbEnableTunAs}"
                            Margin="0,0,6,0" />
                        <ToggleButton
                            x:Name="togEnableTun"
                            Margin="0"
                            HorizontalAlignment="Left"
                            VerticalAlignment="Center"
                            AutomationProperties.Name="{x:Static resx:ResUI.TbEnableTunAs}" />
                    </StackPanel>
                </Border>

                <StackPanel
                    Margin="{StaticResource MarginLeftRight8}"
                    VerticalAlignment="Center"
                    DockPanel.Dock="Left"
                    Orientation="Horizontal">
                    <ComboBox
                        x:Name="cmbSystemProxy"
                        Width="140"
                        Margin="0,0,8,0"
                        Foreground="#00F0FF"
                        materialDesign:HintAssist.Hint="{x:Static resx:ResUI.menuSystemproxy}"
                        AutomationProperties.Name="{x:Static resx:ResUI.menuSystemproxy}"
                        FontSize="{DynamicResource StdFontSize}"
                        Style="{StaticResource MaterialDesignFloatingHintComboBox}">
                        <ComboBoxItem Content="{x:Static resx:ResUI.menuSystemProxyClear}" />
                        <ComboBoxItem Content="{x:Static resx:ResUI.menuSystemProxySet}" />
                        <ComboBoxItem Content="{x:Static resx:ResUI.menuSystemProxyNothing}" />
                        <ComboBoxItem Content="{x:Static resx:ResUI.menuSystemProxyPac}" />
                    </ComboBox>

                    <ComboBox
                        x:Name="cmbRoutings2"
                        Width="140"
                        Foreground="#A78BFA"
                        materialDesign:HintAssist.Hint="{x:Static resx:ResUI.menuRouting}"
                        AutomationProperties.Name="{x:Static resx:ResUI.menuRouting}"
                        DisplayMemberPath="Remarks"
                        FontSize="{DynamicResource StdFontSize}"
                        Style="{StaticResource MaterialDesignFloatingHintComboBox}" />
                </StackPanel>

                <StackPanel Margin="{StaticResource MarginLeftRight8}" VerticalAlignment="Center" Orientation="Horizontal">
                    <materialDesign:PackIcon
                        Kind="RadioboxMarked"
                        Width="15"
                        Height="15"
                        Foreground="#00E676"
                        VerticalAlignment="Center"
                        Margin="0,0,6,0" />
                    <TextBlock
                        x:Name="txtRunningServerDisplay"
                        Foreground="#F8FAFC"
                        FontWeight="Bold"
                        FontSize="12"
                        VerticalAlignment="Center"
                        Margin="0,0,8,0" />
                    <TextBlock
                        x:Name="txtRunningInfoDisplay"
                        Foreground="#38BDF8"
                        FontSize="11"
                        VerticalAlignment="Center" />
                </StackPanel>
            </DockPanel>
        </Border>

        <tb:TaskbarIcon
            x:Name="tbNotify"
            IconSource="/Resources/v2rayN.ico"
            LeftClickCommand="{Binding ShowHideWindowCmd}"
            ToolTipText="NOVA-X Desktop">
            <tb:TaskbarIcon.ContextMenu>
                <ContextMenu Style="{StaticResource DefContextMenu}">
                    <MenuItem
                        x:Name="menuSystemProxyClear"
                        Height="{StaticResource MenuItemHeight}"
                        AutomationProperties.Name="{x:Static resx:ResUI.menuSystemProxyClear}">
                        <MenuItem.Header>
                            <StackPanel Orientation="Horizontal">
                                <materialDesign:PackIcon
                                    x:Name="menuSystemProxyClear2"
                                    Margin="{StaticResource MarginRight8}"
                                    VerticalAlignment="Center"
                                    Kind="Check" />
                                <TextBlock Text="{x:Static resx:ResUI.menuSystemProxyClear}" />
                            </StackPanel>
                        </MenuItem.Header>
                    </MenuItem>
                    <MenuItem
                        x:Name="menuSystemProxySet"
                        Height="{StaticResource MenuItemHeight}"
                        AutomationProperties.Name="{x:Static resx:ResUI.menuSystemProxySet}">
                        <MenuItem.Header>
                            <StackPanel Orientation="Horizontal">
                                <materialDesign:PackIcon
                                    x:Name="menuSystemProxySet2"
                                    Margin="{StaticResource MarginRight8}"
                                    VerticalAlignment="Center"
                                    Kind="Check" />
                                <TextBlock Text="{x:Static resx:ResUI.menuSystemProxySet}" />
                            </StackPanel>
                        </MenuItem.Header>
                    </MenuItem>
                    <MenuItem
                        x:Name="menuSystemProxyNothing"
                        Height="{StaticResource MenuItemHeight}"
                        AutomationProperties.Name="{x:Static resx:ResUI.menuSystemProxyNothing}">
                        <MenuItem.Header>
                            <StackPanel Orientation="Horizontal">
                                <materialDesign:PackIcon
                                    x:Name="menuSystemProxyNothing2"
                                    Margin="{StaticResource MarginRight8}"
                                    VerticalAlignment="Center"
                                    Kind="Check" />
                                <TextBlock Text="{x:Static resx:ResUI.menuSystemProxyNothing}" />
                            </StackPanel>
                        </MenuItem.Header>
                    </MenuItem>
                    <MenuItem
                        x:Name="menuSystemProxyPac"
                        Height="{StaticResource MenuItemHeight}"
                        AutomationProperties.Name="{x:Static resx:ResUI.menuSystemProxyPac}">
                        <MenuItem.Header>
                            <StackPanel Orientation="Horizontal">
                                <materialDesign:PackIcon
                                    x:Name="menuSystemProxyPac2"
                                    Margin="{StaticResource MarginRight8}"
                                    VerticalAlignment="Center"
                                    Kind="Check" />
                                <TextBlock Text="{x:Static resx:ResUI.menuSystemProxyPac}" />
                            </StackPanel>
                        </MenuItem.Header>
                    </MenuItem>
                    <Separator x:Name="sepRoutings" />
                    <MenuItem
                        x:Name="menuRoutings"
                        Height="Auto"
                        AutomationProperties.Name="{x:Static resx:ResUI.menuRouting}">
                        <MenuItem.Header>
                            <DockPanel>
                                <ComboBox
                                    x:Name="cmbRoutings"
                                    MaxWidth="300"
                                    materialDesign:HintAssist.Hint="{x:Static resx:ResUI.menuRouting}"
                                    AutomationProperties.Name="{x:Static resx:ResUI.menuRouting}"
                                    DisplayMemberPath="Remarks"
                                    FontSize="{DynamicResource StdFontSize}"
                                    Style="{StaticResource MaterialDesignFilledComboBox}" />
                            </DockPanel>
                        </MenuItem.Header>
                    </MenuItem>
                    <MenuItem Height="Auto" AutomationProperties.Name="{x:Static resx:ResUI.menuServers}">
                        <MenuItem.Header>
                            <DockPanel>
                                <ComboBox
                                    x:Name="cmbServers"
                                    MaxWidth="300"
                                    materialDesign:HintAssist.Hint="{x:Static resx:ResUI.menuServers}"
                                    AutomationProperties.Name="{x:Static resx:ResUI.menuServers}"
                                    DisplayMemberPath="Text"
                                    FontSize="{DynamicResource StdFontSize}"
                                    Style="{StaticResource MaterialDesignFilledComboBox}" />
                            </DockPanel>
                        </MenuItem.Header>
                    </MenuItem>
                    <Separator />
                    <MenuItem
                        x:Name="menuAddServerViaClipboard2"
                        Height="{StaticResource MenuItemHeight}"
                        Header="{x:Static resx:ResUI.menuAddServerViaClipboard}" />
                    <MenuItem
                        x:Name="menuAddServerViaScan2"
                        Height="{StaticResource MenuItemHeight}"
                        Header="{x:Static resx:ResUI.menuAddServerViaScan}" />
                    <MenuItem
                        x:Name="menuSubUpdate2"
                        Height="{StaticResource MenuItemHeight}"
                        Header="{x:Static resx:ResUI.menuSubUpdate}" />
                    <MenuItem
                        x:Name="menuSubUpdateViaProxy2"
                        Height="{StaticResource MenuItemHeight}"
                        Header="{x:Static resx:ResUI.menuSubUpdateViaProxy}" />
                    <Separator />
                    <MenuItem
                        x:Name="menuCopyProxyCmdToClipboard"
                        Height="{StaticResource MenuItemHeight}"
                        Header="{x:Static resx:ResUI.menuCopyProxyCmdToClipboard}" />
                    <Separator />
                    <MenuItem
                        x:Name="menuExit"
                        Height="{StaticResource MenuItemHeight}"
                        Header="{x:Static resx:ResUI.menuExit}" />
                </ContextMenu>
            </tb:TaskbarIcon.ContextMenu>
        </tb:TaskbarIcon>
    </Grid>
</reactiveui:ReactiveUserControl>
